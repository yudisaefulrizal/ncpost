# Agen AI bawaan: codex, claude, atau cline. Bisa dipilih per video di UI atau dengan --agent.
AGENT=claude
# Codex memakai login ChatGPT dari `codex login`.
# Default mengikuti executable dan konfigurasi model CLI.
CODEX_BIN=codex
CODEX_MODEL=
# Claude memakai login langganan dari `claude login` (ANTHROPIC_API_KEY diabaikan).
CLAUDE_BIN=claude
CLAUDE_MODEL=
# Cline memakai provider yang diatur lewat `cline auth`; mode headless selalu memulai sesi baru.
CLINE_BIN=cline
CLINE_PROVIDER=
CLINE_MODEL=
# Timeout ditentukan pengguna di UI atau melalui --timeout (detik).
# Nilai 0 berarti tanpa batas waktu; tidak ada batas bawaan lain.
# Gaya visual bawaan (nama folder di styles/). Bisa dipilih per video di UI atau dengan --style.
STYLE=vektor-kucing
PORT=8077
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=-5%
REMOTION_GL=angle
