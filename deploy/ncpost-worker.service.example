[Unit]
Description=NC Post Worker
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=nuscode
Group=nuscode
WorkingDirectory=/home/nuscode/projek/- nuscode/ncpost/ncpost-web
Environment=NODE_ENV=production
Environment=PATH=/home/nuscode/.local/bin:/usr/local/bin:/usr/bin:/bin
# Worker memakai login Codex CLI milik user ini (HOME), jadi ProtectHome tidak dipakai.
ExecStart=/home/nuscode/.local/bin/node --import tsx src/worker/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
