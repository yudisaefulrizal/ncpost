# Referensi saja. Tanpa file .env dan tanpa SESSION_SECRET env, bootstrap membuat secret acak 0600.
# SESSION_SECRET=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=ncpost
# DB_PASSWORD=   (diisi otomatis oleh npm run db:setup)
# DB_NAME=ncpost
# DB_TEST_NAME=ncpost_test
LIVE_TTS=false
# Audio berita memakai Edge TTS, terpisah dari LIVE_TTS/ElevenLabs buku.
NEWS_EDGE_TTS=true
NEWS_EDGE_TTS_VOICE=id-ID-ArdiNeural
NEWS_EDGE_TTS_RATE=+0%
# EDGE_TTS_EXECUTABLE=/path/ke/edge-tts (default data/edge-tts/bin/edge-tts)
CODEX_EXECUTABLE=codex
# CODEX_MODEL= (opsional; default CLI)
# PUBLIC_HTTPS=true (wajib untuk deployment HTTPS; cookie Secure)
# NCWA_API_KEY=ncig_ (key khusus aplikasi, bukan salinan proyek lain)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# Video Vektor dibundel di engines/video-vektor; opsional memakai checkout lain.
# VIDEO_VEKTOR_ROOT=/path/ke/video-vektor
# Pipeline memakai suara/rate asli, tidak mengikuti pilihan suara artikel ncpost.
# TTS_VOICE=id-ID-ArdiNeural
# TTS_RATE=-5%
# REMOTION_GL=angle
