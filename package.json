{
  "name": "ncpost-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/run.ts --watch",
    "start": "npm run build && NODE_ENV=production tsx scripts/run.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx src/worker/main.ts",
    "probe": "tsx scripts/probe.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=./data/playwright playwright test",
    "migrate": "tsx scripts/db-migrate.ts",
    "db:setup": "tsx scripts/db-setup.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "mysql2": "3.24.5",
    "opentype.js": "1.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "prettier": "3.6.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
